[Unit]
Description=Create a consistent Second Brain Clipper snapshot
After=clipper-api.service

[Service]
Type=oneshot
WorkingDirectory=/home/coope/codex/second-brain/apps/clipper/backend
EnvironmentFile=/home/coope/codex/second-brain/apps/clipper/.env
ExecStart=/home/coope/codex/second-brain/apps/clipper/backend/.venv/bin/clipper-backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/coope/codex/second-brain/apps/clipper/var
StandardOutput=journal
StandardError=journal
