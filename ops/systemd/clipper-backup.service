[Unit]
Description=Create a consistent Private Topic Clipper snapshot
After=clipper-api.service

[Service]
Type=oneshot
WorkingDirectory=@PROJECT_ROOT@/backend
EnvironmentFile=@PROJECT_ROOT@/.env
ExecStart=@PROJECT_ROOT@/backend/.venv/bin/clipper-backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@PROJECT_ROOT@/var
StandardOutput=journal
StandardError=journal
