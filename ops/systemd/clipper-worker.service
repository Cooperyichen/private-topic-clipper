[Unit]
Description=Private Topic Clipper MinerU Worker
After=network-online.target clipper-api.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_ROOT@/backend
EnvironmentFile=@PROJECT_ROOT@/.env
Environment=MINERU_MODEL_SOURCE=local
ExecStart=@PROJECT_ROOT@/backend/.venv/bin/clipper-worker --poll-seconds 2
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@PROJECT_ROOT@/var @USER_HOME@/.cache @USER_HOME@/.mineru
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=default.target
